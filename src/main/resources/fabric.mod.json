{
  "schemaVersion": 1,
  "id": "dreamveil-prism",
  "version": "${version}",
  "name": "Dreamveil Prism",
  "description": "Creator-facing shader/runtime platform for modern Minecraft Java rendering.",
  "authors": ["Alex Valenzuela"],
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.dreamveil.prism.PrismMod"
    ],
    "client": [
      "dev.dreamveil.prism.client.PrismClient"
    ]
  },
  "mixins": [
    {
      "config": "dreamveil-prism.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=0.157.0"
  }
}
